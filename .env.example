# AI provider: create a key at https://console.groq.com/keys
LLM_PROVIDER=groq
LLM_MODEL=openai/gpt-oss-20b
GROQ_API_KEY=
# Optional alternative: LLM_PROVIDER=openai, LLM_MODEL=gpt-4o
OPENAI_API_KEY=

# Configure one flight provider. AviationStack takes priority if both are set.
SERPAPI_KEY=
AVIATIONSTACK_API_KEY=

# Snowflake password login. Complete MFA if requested.
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_PASSWORD=
SNOWFLAKE_AUTHENTICATOR=snowflake
SNOWFLAKE_WAREHOUSE=COMPUTE_WH
SNOWFLAKE_ROLE=ACCOUNTADMIN
SNOWFLAKE_DATABASE=OAG_FLIGHT_STATUS_DATA_SAMPLE
SNOWFLAKE_SCHEMA=PUBLIC
SNOWFLAKE_TABLE=FLIGHT_STATUS_LATEST_SAMPLE
SNOWFLAKE_DATA_PROFILE=oag
# Google sign-in: AUTHENTICATOR=OAUTH_AUTHORIZATION_CODE, PASSWORD blank.
# Requires the enabled SNOWFLAKE$LOCAL_APPLICATION integration.
# SAML SSO: AUTHENTICATOR=externalbrowser, PASSWORD blank.
# BTS-compatible history: DATA_PROFILE=bts, TABLE=FLIGHTS.

# Paths resolve relative to this project; model and processor stay local.
BARK_MODEL_DIR=./Underdog-Bark-3.0-Clean
BARK_DEVICE=cpu
GRADIO_SERVER_PORT=7860
