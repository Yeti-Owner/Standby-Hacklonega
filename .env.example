# AI provider: create a key at https://console.groq.com/keys
LLM_PROVIDER=groq
LLM_MODEL=openai/gpt-oss-20b
GROQ_API_KEY=
# Optional alternative: LLM_PROVIDER=openai, LLM_MODEL=gpt-4o
OPENAI_API_KEY=

# Configure one flight provider. AviationStack takes priority if both are set.
SERPAPI_KEY=
AVIATIONSTACK_API_KEY=

# Snowflake password login. Complete MFA if requested.
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_PASSWORD=
SNOWFLAKE_AUTHENTICATOR=snowflake
SNOWFLAKE_WAREHOUSE=COMPUTE_WH
SNOWFLAKE_ROLE=ACCOUNTADMIN
SNOWFLAKE_DATABASE=OAG_FLIGHT_STATUS_DATA_SAMPLE
SNOWFLAKE_SCHEMA=PUBLIC
SNOWFLAKE_TABLE=FLIGHT_STATUS_LATEST_SAMPLE
SNOWFLAKE_DATA_PROFILE=oag
# Google sign-in: AUTHENTICATOR=OAUTH_AUTHORIZATION_CODE, PASSWORD blank.
# Requires the enabled SNOWFLAKE$LOCAL_APPLICATION integration.
# SAML SSO: AUTHENTICATOR=externalbrowser, PASSWORD blank.
# BTS-compatible history: DATA_PROFILE=bts, TABLE=FLIGHTS.

# Paths resolve relative to this project; model and processor stay local.
BARK_MODEL_DIR=./Underdog-Bark-3.0-Clean
BARK_DEVICE=auto
GRADIO_SERVER_PORT=7860

GROQ_DAILY_REQUEST_LIMIT=50

GROQ_MAX_OUTPUT_TOKENS=1024

# Public airport context (Open-Meteo, NOAA, FAA, Security Wait Times) needs no keys.
# Requests run only after confirmation, with short-lived caches.

# Calendar used for relative dates such as today/tomorrow (IANA timezone).
APP_TIMEZONE=America/New_York

# Combined React + Python app. No keys belong in NEXT_PUBLIC_* variables.
STANDBY_API_PORT=7860
STANDBY_WEB_PORT=3000
# Demo button appears automatically if configuration is missing; 1 always shows it.
STANDBY_SHOW_DEMO=0
